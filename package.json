{
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "cron": "^4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "he": "^2.0.0",
    "luxon": "^3.7.2",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "tar": "^7.5.22",
    "ws": "^8.22.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "undici": "6.29.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0"
  },
  "name": "Hachi",
  "description": "This Discord bot will automatically send a message and tag the assigned role whenever a streamer went live.\r The notifications will update every 10 minutes(default) while the streamer is live.",
  "version": "3.12.1",
  "main": "index.js",
  "scripts": {
    "start": "node .",
    "pm2:start": "pm2 start config/ecosystem.config.js",
    "check": "node scripts/syntaxCheck.js",
    "db:audit": "node database/dbAudit.js",
    "db:migrate": "node database/dbAudit.js --migrate",
    "db:migrate:force": "node database/dbAudit.js --force",
    "lint": "eslint . --config config/eslint.config.js",
    "lint:fix": "eslint . --config config/eslint.config.js --fix",
    "release:check": "node scripts/releaseCheck.js",
    "smoke": "node scripts/smokeTest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FearlessKenji/Hachi.git"
  },
  "keywords": [
    "discord",
    "bot",
    "twitch",
    "reddit",
    "notification",
    "notify"
  ],
  "author": "FearlessKenji",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FearlessKenji/Hachi/issues"
  },
  "homepage": "https://github.com/FearlessKenji/Hachi#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "commonjs"
}
